# Shared placement-mutation tracking for True-3D CTS.
#
# The CTS construction process records a geometry snapshot before its first
# mutation, then emits one dirty-instance list per tier after all CTS geometry
# mutations have completed.  The tier finalizers consume those lists in the
# matching CORE views.

namespace eval cts3d_place {}

proc cts3d_place::tier_from_master_name {master_name} {
  if {[string match "*_bottom" $master_name]} {
    return bottom
  }
  if {[string match "*_upper" $master_name]} {
    return upper
  }
  return unknown
}

proc cts3d_place::capture_snapshot {block} {
  set snapshot [dict create]
  foreach inst [$block getInsts] {
    set name [$inst getName]
    set master [$inst getMaster]
    if {$master eq "" || $master eq "NULL"} {
      error "3DCTS snapshot cannot resolve master for instance $name"
    }
    dict set snapshot $name [list \
      [$master getName] \
      [$inst getOrigin] \
      [$inst getOrient]]
  }
  return $snapshot
}

proc cts3d_place::diff_snapshot {snapshot block} {
  set dirty_bottom {}
  set dirty_upper {}
  set dirty_unknown {}
  set reasons [dict create]
  set new_count 0
  set master_count 0
  set position_count 0
  set orientation_count 0

  foreach inst [$block getInsts] {
    set name [$inst getName]
    set master [$inst getMaster]
    if {$master eq "" || $master eq "NULL"} {
      error "3DCTS dirty tracking cannot resolve master for instance $name"
    }
    set master_name [$master getName]
    set origin [$inst getOrigin]
    set orient [$inst getOrient]
    set changed {}

    if {![dict exists $snapshot $name]} {
      lappend changed new
      incr new_count
    } else {
      lassign [dict get $snapshot $name] old_master old_origin old_orient
      if {$master_name ne $old_master} {
        lappend changed master
        incr master_count
      }
      if {$origin ne $old_origin} {
        lappend changed position
        incr position_count
      }
      if {$orient ne $old_orient} {
        lappend changed orientation
        incr orientation_count
      }
    }

    if {[llength $changed] == 0} {
      continue
    }

    set tier [cts3d_place::tier_from_master_name $master_name]
    switch -- $tier {
      bottom { lappend dirty_bottom $name }
      upper { lappend dirty_upper $name }
      default { lappend dirty_unknown $name }
    }
    dict set reasons $name $changed
  }

  set removed_count 0
  foreach name [dict keys $snapshot] {
    set inst [$block findInst $name]
    if {$inst eq "" || $inst eq "NULL"} {
      incr removed_count
    }
  }

  return [dict create \
    bottom [lsort -unique $dirty_bottom] \
    upper [lsort -unique $dirty_upper] \
    unknown [lsort -unique $dirty_unknown] \
    reasons $reasons \
    new_count $new_count \
    master_count $master_count \
    position_count $position_count \
    orientation_count $orientation_count \
    removed_count $removed_count]
}

proc cts3d_place::write_dirty_list {path tier names} {
  if {$tier ne "bottom" && $tier ne "upper"} {
    error "3DCTS cannot write dirty list for unsupported tier '$tier'"
  }
  set unique_names [lsort -unique $names]
  if {[llength $unique_names] != [llength $names]} {
    error "3DCTS dirty list for $tier contains duplicate instance names"
  }
  file mkdir [file dirname $path]
  set stream [open $path w]
  puts $stream "# Generated by True-3D CTS; consumed by cts_3d_finalize_tier.tcl."
  puts $stream "set ::cts3d_dirty_tier [list $tier]"
  puts $stream "set ::cts3d_dirty_count [llength $unique_names]"
  puts $stream "set ::cts3d_dirty_cells [list $unique_names]"
  close $stream
}

proc cts3d_place::write_dirty_report {path diff} {
  file mkdir [file dirname $path]
  set stream [open $path w]
  puts $stream "tier\tinstance\treasons"
  foreach tier {bottom upper unknown} {
    foreach name [dict get $diff $tier] {
      puts $stream "$tier\t$name\t[join [dict get $diff reasons $name] ,]"
    }
  }
  close $stream
}
