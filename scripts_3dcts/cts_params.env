# ============================================================================
# cts_params.env — parameters for the F2F 3D useful-skew CTS flow.
#
# This is the single, shared configuration for all designs and both platforms.
# Non-macro defaults are set here. Platform-specific buffer masters and the
# heterogeneous-stack flag are derived after the current TaiWei design is
# loaded by platform_config.tcl; callers can still override them explicitly.
#
# The knobs are grouped by the four phases of the flow:
#   Phase 1  balanced 3D H-tree + propagated-clock timing analysis
#   Phase 2  delivery-constrained useful-skew scheduling (OR-Tools GLOP LP)
#   Phase 3  shared tap delivery (one cascaded chain per branch and tier)
#   Phase 4  tap reassignment + skew-aware buffer sizing
# Every variable uses ${VAR:-default} so it can be overridden from the shell.
# ============================================================================

# --- TaiWei integration paths ---
# Do not override FLOW_VARIANT or TaiWei's formal RESULTS_DIR. All private
# timing graphs, LP files and debug artifacts live below OBJECTS_DIR/3dcts.
if [[ -z "${CTS3D_WORK_DIR:-}" ]]; then
  echo "ERROR: CTS3D_WORK_DIR must be set before sourcing cts_params.env" >&2
  return 1
fi
export CTS_RESULTS_DIR="$CTS3D_WORK_DIR"
export HETEROGENEOUS_3D="${HETEROGENEOUS_3D:-}"

# --- Phase controls ---
export ENABLE_PROPAGATED_CTS="${ENABLE_PROPAGATED_CTS:-1}"      # Phase 1: build balanced tree, analyze with propagated clocks
export ENABLE_POST_CTS_LP="${ENABLE_POST_CTS_LP:-0}"           # optional post-CTS LP re-solve (off; <0.2ns gain)
export CTS_REUSE_TIMING_GRAPH="${CTS_REUSE_TIMING_GRAPH:-1}"    # reuse Phase-1 CSVs if already present
export CTS_ENABLE_DEBUG_EXTRACT="${CTS_ENABLE_DEBUG_EXTRACT:-1}" # write per-FF / per-edge measurement CSVs

# Optional monotonic acceptance gate. When 1, run.sh measures a balanced-only
# reference and rebuilds in balanced mode if useful-skew delivery regressed
# below it. Off by default; the reported results never triggered a rebuild.
export CTS_ACCEPTANCE_GATE="${CTS_ACCEPTANCE_GATE:-0}"
export CTS_ACCEPTANCE_MARGIN_PS="${CTS_ACCEPTANCE_MARGIN_PS:-0.0}"

# --- Macro handling (set per-design in run.sh for swerv_wrapper / ariane133) ---
# CTS_NO_INSERTION_DELAY=1 disables the latency balancer for macro-dominated
# designs, where balancing macro/register latency degrades cross-tier hold.
export CTS_NO_INSERTION_DELAY="${CTS_NO_INSERTION_DELAY:-0}"

# --- Phase 2: useful-skew scheduler (C++ OR-Tools GLOP, endpoint-TNS, 2-phase) ---
export PRE_CTS_ENABLE_2PHASE=1                                  # Phase A minimize WNS, Phase B minimize TNS under WNS bound
export PRE_CTS_WNS_ALPHA=0.05                                   # Phase B: allowed WNS relaxation from Phase A optimum
export PRE_CTS_GAMMA_WNS=10.0                                   # WNS minimax weight (single-phase fallback)
export PRE_CTS_HARD_PI_HOLD=0                                   # soft PI->FF hold (propagated slacks already encode latency)
export PRE_CTS_SIGMA_PI=0.005                                   # PI->FF hold safety margin (ns)
export PRE_CTS_SIGMA_LOCAL="0.001"
export PRE_CTS_MAX_SKEW="${PRE_CTS_MAX_SKEW:-0.100}"            # scheduled arrival bound (ns)
export PRE_CTS_LAMBDA_REG="${PRE_CTS_LAMBDA_REG:-0.01}"
export PRE_CTS_HOLD_MARGIN="${PRE_CTS_HOLD_MARGIN:-0.003}"
export PRE_CTS_WEIGHT_IO="${PRE_CTS_WEIGHT_IO:-1.0}"
# Per-clock LP: cross-clock edges form cyclic hold constraints; solving each
# clock domain independently keeps the LP feasible on multi-clock designs.
export CTS_PER_CLOCK_LP="${CTS_PER_CLOCK_LP:-1}"
export CTS_TIMING_GRAPH_CSV="$CTS3D_WORK_DIR/pre_cts_ff_timing_graph.csv"
export CTS_IO_TIMING_CSV="$CTS3D_WORK_DIR/pre_cts_io_timing_edges.csv"

# --- Phase 3: tree construction and shared tap delivery ---
export CTS_ENABLE_UNIFIED_TREE="${CTS_ENABLE_UNIFIED_TREE:-1}"  # one H-tree over all sinks (both tiers)
export CTS_ENABLE_PER_TIER_CTS="${CTS_ENABLE_PER_TIER_CTS:-0}"  # per-tier trees widen tier latency; off
export CTS_ENABLE_GH_TREE="${CTS_ENABLE_GH_TREE:-1}"            # cascaded tap chains enabled
export CTS_ENABLE_GROUPED_DELAY="${CTS_ENABLE_GROUPED_DELAY:-1}"
export CTS_GROUPED_DELAY_MAX_DEPTH="${CTS_GROUPED_DELAY_MAX_DEPTH:-6}"
export CTS_GROUPED_DELAY_MIN_DELTA_NS=0.00
export CTS_GROUPED_DELAY_CLUSTER_UNIFORM=0                      # per-FF tap depth (not cluster-uniform)
# Shared tap delivery: one cascaded chain per (branch, tier); a remote group
# reaches its chain through a single hybrid-bonding terminal.
export CTS_SHARED_TAP="${CTS_SHARED_TAP:-1}"
export CTS_SHARED_TAP_XTIER="${CTS_SHARED_TAP_XTIER:-0}"
# Bridge: dedicated 2-pin cross-tier entry with tap-depth compensation.
export CTS_BRIDGE_PROTOTYPE="${CTS_BRIDGE_PROTOTYPE:-1}"
export CTS_BRIDGE_BRANCH="${CTS_BRIDGE_BRANCH:--1}"
export CTS_BRIDGE_DEPTH_COMP="${CTS_BRIDGE_DEPTH_COMP:-1}"

# Timing-affinity (TARP) clustering and directional branch-point skew: both off
# by default (they restructure the tree and widen tier latency).
export CTS_ENABLE_TARP="${CTS_ENABLE_TARP:-0}"
export CTS_TARP_ALPHA=0.7
export CTS_TARP_TOP_K=30
export CTS_TARP_SLACK_THRESH=0.3
export CTS_TARP_FM_PASSES=10
export CTS_ENABLE_DIR_SKEW="${CTS_ENABLE_DIR_SKEW:-0}"
export CTS_DIR_SKEW_ALPHA="${CTS_DIR_SKEW_ALPHA:-0.40}"
export CTS_DIR_MAX_SHIFT="${CTS_DIR_MAX_SHIFT:-12.0}"
export CTS_DIR_SKEW_MAX_LEVEL="${CTS_DIR_SKEW_MAX_LEVEL:-3}"
export CTS_ENABLE_ITERATION=0

# Superseded / disabled construction features.
export CTS_ENABLE_PER_FF_RELAY=0
export CTS_ENABLE_TARGET_SPLIT=0
export CTS_ENABLE_MID_DELAY_BUFS=0
export CTS_ENABLE_TIER_SPLIT=0
export CTS_ENABLE_LAYER_ASSIGNMENT=0

# --- Phase 4: tap reassignment (in-flow) + skew-aware buffer sizing ---
export CTS_ENABLE_CTR="${CTS_ENABLE_CTR:-1}"                    # post-CTS adaptive tap reassignment + tap resizing
export CTS_CTR_BATCH="${CTS_CTR_BATCH:-10}"                     # moves per measure-and-revert batch
export CTS_CTR_ACCEPT_MIN="${CTS_CTR_ACCEPT_MIN:-0.0}"         # accept batch iff d(setupTNS)+d(holdTNS) > this
export CTS_CTR_WNS_GUARD="${CTS_CTR_WNS_GUARD:-1}"             # revert any batch that degrades setup/hold WNS
export CTS_CTR_WNS_EPS="${CTS_CTR_WNS_EPS:-0}"
export CTS_CTR_TNS_GUARD="${CTS_CTR_TNS_GUARD:-1}"             # per-metric non-regression (win-or-tie only)
export CTS_CTR_TNS_EPS="${CTS_CTR_TNS_EPS:-0.0}"

export ENABLE_BUFFER_INSERTION=0                               # relay-buffer insertion (unused)
export ENABLE_BUFFER_SIZING=1                                 # post-CTS buffer sizing LP
export BUFFER_SIZING_ITERATIVE=1
export POST_CTS_MAX_SKEW="${POST_CTS_MAX_SKEW:-0.100}"
export POST_CTS_SIGMA_LOCAL="${POST_CTS_SIGMA_LOCAL:-0.005}"
export POST_CTS_HOLD_MARGIN="${POST_CTS_HOLD_MARGIN:-0.005}"
export POST_CTS_LAMBDA_REG="${POST_CTS_LAMBDA_REG:-0.001}"
export POST_CTS_SKEW_WEIGHT="${POST_CTS_SKEW_WEIGHT:-0.5}"
export HOLD_WEIGHT=0.5
export SIZING_MAX_ITERS=20
export SIZING_REFRESH_INTERVAL=10
export MAX_CONSEC_REJECTS=10
export HOLD_TNS_TOLERANCE=50.0
export SKIP_HOLD_GUARD=0
export LP_SETUP_MARGIN=0.0
export LP_HOLD_MARGIN=0.0
export CTS_AUTO_UPDATE_TAP="${CTS_AUTO_UPDATE_TAP:-0}"
export CTS_ENABLE_HOLD_BUDGET_CAP="${CTS_ENABLE_HOLD_BUDGET_CAP:-0}"  # LP is already hold-safe; cap would block most delivery
export ENABLE_HOLD_REPAIR="${ENABLE_HOLD_REPAIR:-0}"

# --- Detailed placement of clock cells ---
export SKIP_HETERO_DPL="${SKIP_HETERO_DPL:-1}"                 # skip upper-tier DPL on the heterogeneous stack

# --- Timing-graph extraction ---
# EXTRACT_MODE=graph selects the fast arc-graph FF-edge extractor (single forward
# pass over the timing DAG). It is bit-exact to the default STA extractor
# (unset / any other value) but much faster on large designs. Only consulted when
# Phase 1 actually runs (CTS_REUSE_TIMING_GRAPH=0 or the CSVs are absent).
export EXTRACT_MODE="${EXTRACT_MODE:-graph}"
export BATCH_TIMING=1
export EXTRACT_PATH_LIMIT="${EXTRACT_PATH_LIMIT:-20000}"       # LP edge limit (macro designs may lower this in run.sh)
export EXTRACT_BATCH_SIZE="${EXTRACT_BATCH_SIZE:-1}"           # 1 = coverage-faithful graph (batch>1 drops edges)
export EXTRACT_PATHFIX="${EXTRACT_PATHFIX:-0}"

# Routing remains owned by the current TaiWei flow.  This stage publishes the
# standard 4_cts handoff and does not install a legacy global-route hook.
