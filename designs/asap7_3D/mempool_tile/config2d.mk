export DESIGN_NAME = mempool_tile
export PLATFORM = asap7
RTL_DIR := $(DESIGN_HOME)/src/mempool_tile/asap7/rtl
export VERILOG_FILES = $(sort $(wildcard $(RTL_DIR)/*.sv))
export VERILOG_INCLUDE_DIRS = $(DESIGN_HOME)/src/mempool_tile/asap7/include
export VERILOG_DEFINES = \
  -D TARGET_SYNTHESIS \
  -D XPULPIMG=1 \
  -D AXI_DATA_WIDTH=512 \
  -D NUM_CORES=256 \
  -D NUM_CORES_PER_TILE=4 \
  -D NUM_GROUPS=4 \
  -D BANKING_FACTOR=4 \
  -D AXI_HIER_RADIX=17 \
  -D AXI_MASTERS_PER_GROUP=1 \
  -D DMAS_PER_GROUP=1 \
  -D L2_SIZE=4194304 \
  -D L2_BANKS=4 \
  -D RO_LINE_WIDTH=512 \
  -D SEQ_MEM_SIZE=512 \
  -D XQUEUE_SIZE=0
export SYNTH_HDL_FRONTEND = slang
export SDC_FILE = $(DESIGN_HOME)/asap7_3D/mempool_tile/constraint.sdc
export ADDITIONAL_LEFS = $(PLATFORM_DIR)/lef/fakeram/mempool_tile/ht_asap7_mempoolgroup_32x256.lef $(PLATFORM_DIR)/lef/fakeram/mempool_tile/ht_asap7_mempoolgroup_64x64.lef
export ADDITIONAL_LIBS = $(PLATFORM_DIR)/lib/NLDM/fakeram/mempool_tile/ht_asap7_mempoolgroup_32x256.lib $(PLATFORM_DIR)/lib/NLDM/fakeram/mempool_tile/ht_asap7_mempoolgroup_64x64.lib
export CORE_MARGIN = 0.2
export CORE_UTILIZATION ?= 60
export NUM_CORES ?= 32
export PIN3D_SPLIT_PORT_DRIVEN_NETS ?= 1
